          { "kicker": "MOBILE WEB", "text": "HTML · CSS · JavaScript", "icon": "cloud", "cue": "w" },
          { "kicker": "HYBRID", "text": "Web code + Ionic, Capacitor", "icon": "layers", "cue": "h" }
        ]
      },
      "sentences": [
        { "caption": "*Native*#n uses the platform's own language: | Kotlin for Android, | Swift for iOS." },
        { "caption": "Mobile *web*#w is HTML, CSS and JavaScript, | opened in the browser." },
        { "caption": "*Hybrid*#h is that same web code, | wrapped in a native shell | with tools like Ionic and Capacitor." }
