          { "kicker": "MOBILE WEB", "text": "Browser: Blink, WebKit", "icon": "cloud", "cue": "w" },
          { "kicker": "HYBRID", "text": "WebView inside the app", "icon": "layers", "cue": "h" }
        ]
      },
      "sentences": [
        { "caption": "*Native*#n draws with the OS's own UI toolkit, | like Jetpack Compose or SwiftUI." },
        { "caption": "Mobile *web*#w is drawn by the browser engine: | Blink in Chrome, | WebKit in Safari." },
        { "caption": "*Hybrid*#h runs inside a *WebView*, | a browser hidden inside the app." }
