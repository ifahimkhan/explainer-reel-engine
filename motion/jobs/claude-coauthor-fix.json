{
  "id": "claude-coauthor-fix",
  "engine": "elevenlabs",
  "voice": "ruZOzaKd6ljzH7J9ejYE",
  "model": "eleven_flash_v2_5",
  "voiceSettings": { "stability": 0.5, "similarity_boost": 0.8 },
  "sentenceGap": 0.14,
  "sceneGap": 0.3,
  "tail": 1.2,
  "copy": {},
  "scenes": [
    {
      "id": "hook",
      "visual": {
        "type": "pair",
        "label": "CLAUDE CODE TIP",
        "left": { "title": "Claude Code", "sub": "AI AGENT", "icon": "terminal", "dark": true },
        "right": { "title": "Git", "sub": "YOUR COMMITS", "icon": "github" },
        "stamp": { "text": "CO-AUTHOR?", "cue": "stamp" }
      },
      "sentences": [
        { "caption": "Claude Code is signing your Git commits | as a *co-author*.#stamp" },
        { "caption": "Here's the *one-line* fix." }
      ]
    },
    {
      "id": "problem",
      "visual": {
        "type": "terminal",
        "label": "THE PROBLEM",
        "title": "git log",
        "command": "git log -1",
        "cue": "cmd",
        "lines": [
          { "text": "commit 3f9a2c1e7b04d58a", "tone": "good" },
          { "text": "Author: Fahim Khan", "tone": "dim" },
          { "text": "" },
          { "text": "    fix: tighten upload retry logic" },
          { "text": "" },
          { "text": "    Co-Authored-By: Claude", "tone": "dim", "flag": "flag" }
        ]
      },
      "sentences": [
        { "caption": "Run git#cmd log, | and there it is." },
        { "caption": "*Co-Authored-By*#flag Claude, | on every single commit." }
      ]
    },
    {
      "id": "wrongfix",
      "visual": {
        "type": "editor",
        "label": "THE USUAL FIX",
        "file": "CLAUDE.md",
        "lines": [
          { "text": "# Git commits", "cue": "l1" },
          { "text": "Don't add Co-Authored-By", "cue": "l2" },
          { "text": "to my commits. Please.", "cue": "l2" }
        ],
        "strike": { "cue": "strike" },
        "note": { "text": "A setting works every time", "cue": "note" }
      },
      "sentences": [
        { "caption": "Most people add a rule to CLAUDE.md#l1 | asking it to stop.#l2" },
        { "caption": "That's a *prompt*.#strike | A setting is *guaranteed*.#note" }
      ]
    },
    {
      "id": "paths",
      "visual": {
        "type": "tabs",
        "label": "SETTINGS FILE",
        "title": "settings.json",
        "tabs": [
          { "name": "Global", "value": "~/.claude/settings.json", "cue": "g", "tree": ["~ (home)", "  .claude/", "    settings.json"] },
          { "name": "Project", "value": ".claude/settings.json", "cue": "p", "tree": ["your-repo/", "  .claude/", "    settings.json"] }
        ]
      },
      "sentences": [
        { "caption": "Open your *settings.json* instead." },
        { "caption": "*Global*,#g in the dot claude folder | in your home directory." },
        { "caption": "Or *per* *project*,#p in dot claude | inside your repo." }
      ]
    },
    {
      "id": "fix",
      "visual": {
        "type": "editor",
        "label": "THE FIX",
        "file": "~/.claude/settings.json",
        "lines": [
          { "text": "{" },
          { "text": "  \"attribution\": {", "cue": "a" },
          { "text": "    \"commit\": \"\"", "cue": "c", "hl": true },
          { "text": "  }", "cue": "a" },
          { "text": "}" }
        ],
        "toast": { "text": "Saved", "cue": "saved" }
      },
      "sentences": [
        { "caption": "Add an *attribution*#a object, | and set commit#c to an empty string." },
        { "caption": "That's it.#saved" }
      ]
    },
    {
      "id": "proof",
      "visual": {
        "type": "terminal",
        "label": "THE RESULT",
        "title": "git log",
        "command": "git log -1",
        "lines": [
          { "text": "commit 8c41d07a92e3f611", "tone": "good" },
          { "text": "Author: Fahim Khan", "tone": "dim" },
          { "text": "" },
          { "text": "    feat: add offline cache" },
          { "text": "" },
          { "text": "    Co-Authored-By: Claude", "tone": "bad", "drop": "gone" }
        ],
        "badge": { "text": "No co-author", "cue": "gone" }
      },
      "sentences": [
        { "caption": "Next commit, | the co-author line is *gone*.#gone" }
      ]
    },
    {
      "id": "bonus",
      "visual": {
        "type": "editor",
        "label": "BONUS",
        "file": "~/.claude/settings.json",
        "lines": [
          { "text": "{" },
          { "text": "  \"attribution\": {" },
          { "text": "    \"commit\": \"\"," },
          { "text": "    \"pr\": \"\"", "cue": "pr", "hl": true },
          { "text": "  }" },
          { "text": "}" }
        ],
        "toast": { "text": "PR footer removed", "cue": "toast" }
      },
      "sentences": [
        { "caption": "Set *pr*#pr to empty too, | and your pull requests drop | the Generated#toast with Claude Code footer." }
      ]
    },
    {
      "id": "myfile",
      "visual": {
        "type": "screenshot",
        "label": "MY SETUP",
        "title": "my settings.json",
        "src": "claude-attribution/settings-json.png",
        "width": 1391,
        "height": 757,
        "focus": { "x": 210, "y": 295, "w": 520, "h": 215, "cue": "zoom" },
        "highlights": [
          { "x": 288, "y": 352, "w": 300, "h": 50, "cue": "c", "label": "commit" },
          { "x": 288, "y": 405, "w": 190, "h": 50, "cue": "p", "label": "pr" }
        ]
      },
      "sentences": [
        { "caption": "Here's my own#zoom settings file." },
        { "caption": "*Commit*#c and *PR*,#p | both set to empty." }
      ]
    },
    {
      "id": "takeaway",
      "visual": {
        "type": "merge",
        "label": "THE TAKEAWAY",
        "headline": "Not everything needs a prompt",
        "highlight": "prompt",
        "items": [
          { "text": "Prompt", "icon": "chat", "cue": "i1" },
          { "text": "Skill", "icon": "sparkle", "cue": "i2" },
          { "text": "CLAUDE.md", "icon": "file", "cue": "i3" }
        ],
        "result": { "text": "A setting", "sub": "ALWAYS ON", "cue": "r" }
      },
      "sentences": [
        { "caption": "Not every behavior needs another prompt,#i1 | skill,#i2 or CLAUDE.md#i3 rule." },
        { "caption": "Sometimes it's just#r a *setting*." }
      ]
    },
    {
      "id": "cta",
      "visual": {
        "type": "follow",
        "label": "FOLLOW",
        "headline": "More Claude Code tips",
        "highlight": "tips",
        "name": "Fahim Khan",
        "tagline": "PRACTICAL AI DEV TIPS",
        "cue": "follow"
      },
      "sentences": [
        { "caption": "*Follow*#follow for more Claude Code tips | like this." }
      ]
    }
  ]
}
