      "sentences": [
        { "caption": "First: the *setup*. | Use a low-RAM#ram device, | or an emulator with 2 gigabytes of memory." },
        { "caption": "Fill#bg the background: | music streaming, navigation, camera, | and a game." },
        { "caption": "Then send memory *pressure*#trim | with adb shell am send-trim-memory." }
      ]
    },
    {
      "id": "clutter",
      "visual": {
        "type": "journey",
        "label": "ADD THE CLUTTER",
