          { "name": "Rotate", "sub": "and zoom", "icon": "aperture", "cue": "c4", "tone": "bad" }
        ]
      },
      "sentences": [
        { "caption": "Second: add the *clutter*. | Request a ride in a busy area, | with fifty#c1 cars around you." },
        { "caption": "Turn on surge#c2 zones, chat#c3 messages, | and fast location updates." },
        { "caption": "*Rotate*#c4 the screen and zoom in and out | while the car moves." }
      ]
    },
    {
      "id": "watch",
      "visual": {
        "type": "trio",
        "label": "WHAT TO WATCH",
        "title": "Third: what to watch",
        "rows": [
          { "kicker": "MARKERS", "text": "Glide smoothly, never jump", "icon": "arrowRight", "cue": "m" },
          { "kicker": "MAP TILES", "text": "Never blank or grey", "icon": "image", "cue": "t" },
          { "kicker": "PROCESS DEATH", "text": "Trip comes back exactly", "icon": "check", "cue": "p" }
        ]
      },
      "sentences": [
        { "caption": "Third: what to *watch*. | Car markers#m should glide smoothly, | not jump." },
        { "caption": "Map tiles#t should never go *blank* or grey." },
        { "caption": "And if Android kills#p the app, | the trip must come back *exactly* as it was." }
      ]
    },
    {
      "id": "measure",
      "visual": {
        "type": "terminal",
        "label": "MEASURE",
        "title": "adb",
        "command": "adb shell dumpsys gfxinfo cab.app",
        "cue": "gfx",
        "lines": [
          { "text": "Total frames rendered: 3120", "tone": "normal" },
          { "text": "Janky frames: 412 (13.2%)", "tone": "dim", "flag": "drops" },
          { "text": "90th percentile: 38ms", "tone": "dim" }
        ],
        "badge": { "text": "+ Memory Profiler", "cue": "mem" }
      },
      "sentences": [
        { "caption": "*Measure*, don't guess." },
        { "caption": "Check frame#drops drops with dumpsys#gfx gfxinfo, | and memory with the *Memory*#mem Profiler." }
      ]
    },
