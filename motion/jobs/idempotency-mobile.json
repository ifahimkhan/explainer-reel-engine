{
  "id": "idempotency-mobile",
  "engine": "elevenlabs",
  "voice": "ruZOzaKd6ljzH7J9ejYE",
  "model": "eleven_flash_v2_5",
  "voiceSettings": { "stability": 0.5, "similarity_boost": 0.8 },
  "sentenceGap": 0.6,
  "sceneGap": 1.0,
  "tail": 2.3,
  "copy": {},
  "scenes": [
    {
      "id": "hook",
      "visual": {
        "type": "title",
        "label": "IDEMPOTENCY",
        "kicker": "MOBILE NETWORK RETRIES",
        "headline": "Tap once, charged twice",
        "highlight": "twice",
        "icon": "dollar",
        "sub": { "text": "A missing idempotency key", "cue": "twice" }
      },
      "sentences": [
        { "caption": "You tap *Pay*. | The network drops. | The app retries." },
        { "caption": "And now you're charged *twice*.#twice" }
      ]
    },
    {
      "id": "problem",
      "visual": {
        "type": "compare",
        "label": "THE PROBLEM",
        "left": { "kicker": "REQUEST", "title": "Reached server", "items": ["Payment processed"], "cue": "reach" },
        "right": { "kicker": "RESPONSE", "title": "Lost on the way", "items": ["App sees a timeout", "Sends it again"], "cue": "lost" }
      },
      "sentences": [
        { "caption": "On mobile, a request can *reach*#reach the server, | but the response gets *lost*#lost on the way back." },
        { "caption": "The app thinks it failed, | so it sends the request *again*." }
      ]
    },
    {
      "id": "meaning",
      "visual": {
        "type": "title",
        "label": "WHAT IT MEANS",
        "kicker": "IDEMPOTENCY",
        "headline": "Many requests, one effect",
        "highlight": "one",
        "icon": "check",
        "sub": { "text": "GET · PUT · DELETE are safe to retry", "cue": "get" }
      },
      "sentences": [
        { "caption": "*Idempotency* means sending the same request many times | has the same effect as sending it *once*." },
        { "caption": "GET,#get PUT and DELETE | are idempotent by *design*." }
      ]
    },
    {
      "id": "post",
      "visual": {
        "type": "terminal",
        "label": "POST IS NOT",
        "title": "network",
        "command": "POST /payments",
        "cue": "post",
        "lines": [
          { "text": "201 Created  order #1041", "tone": "good" },
          { "text": "timeout, retrying...", "tone": "dim" },
          { "text": "201 Created  order #1042", "tone": "normal", "flag": "new" }
        ],
        "badge": { "text": "Charged twice", "cue": "payment" }
      },
      "sentences": [
        { "caption": "*POST*#post is *not*." },
        { "caption": "Every retry can create a *new*#new order, | or a new *payment*.#payment" }
      ]
    },
    {
      "id": "fix",
      "visual": {
        "type": "editor",
        "label": "THE FIX",
        "file": "PaymentRepository.kt",
        "lines": [
          { "text": "val key = UUID.randomUUID().toString()", "cue": "uuid", "hl": true },
          { "text": "" },
          { "text": "api.pay(", "cue": "hdr" },
          { "text": "  header(\"Idempotency-Key\", key),", "cue": "hdr", "hl": true },
          { "text": "  body = order", "cue": "hdr" },
          { "text": ")", "cue": "hdr" }
        ],
        "toast": { "text": "Same key: saved result", "cue": "saved" },
        "note": { "text": "Server stores key + result", "cue": "server" }
      },
      "sentences": [
        { "caption": "The fix: | an *idempotency* *key*." },
        { "caption": "The app creates a unique key, | a *UUID*,#uuid for each user action." },
        { "caption": "It sends the key in a *header*#hdr | with every retry of that request." },
        { "caption": "The server#server *saves* the key with the result." },
        { "caption": "If the same key comes back, | it returns the *saved*#saved result | instead of running it again." }
      ]
    },
    {
      "id": "rule",
      "visual": {
        "type": "steps",
        "label": "THE RULE",
        "title": "Get the key right",
        "steps": [
          { "label": "Once per action", "sub": "not once per retry", "icon": "lock", "cue": "once" },
          { "label": "Persist the key", "sub": "survives app restart", "icon": "db", "cue": "save" }
        ]
      },
      "sentences": [
        { "caption": "Make the key once#once per *action*, | not once per retry." },
        { "caption": "*Save*#save it, | so it survives an app *restart*." }
      ]
    },
    {
      "id": "cta",
      "visual": {
        "type": "follow",
        "label": "FOLLOW",
        "headline": "More Android tips",
        "highlight": "Android",
        "name": "Fahim Khan",
        "tagline": "PRACTICAL ANDROID DEV TIPS",
        "cue": "follow"
      },
      "sentences": [
        { "caption": "*Follow*#follow for more Android tips." }
      ]
    }
  ]
}
