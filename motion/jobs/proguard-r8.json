{
  "id": "proguard-r8",
  "engine": "elevenlabs",
  "voice": "ruZOzaKd6ljzH7J9ejYE",
  "model": "eleven_flash_v2_5",
  "voiceSettings": { "stability": 0.5, "similarity_boost": 0.8 },
  "sentenceGap": 0.6,
  "sceneGap": 1.0,
  "tail": 2.3,
  "copy": {},
  "scenes": [
    {
      "id": "hook",
      "visual": {
        "type": "title",
        "label": "PROGUARD / R8",
        "kicker": "RELEASE BUILDS",
        "headline": "Your APK ships dead weight",
        "highlight": "dead",
        "icon": "layers",
        "sub": { "text": "And anyone can read it", "cue": "read" }
      },
      "sentences": [
        { "caption": "Your app ships code it never *uses*." },
        { "caption": "And anyone can *read*#read it." }
      ]
    },
    {
      "id": "what",
      "visual": {
        "type": "merge",
        "label": "WHAT IT IS",
        "headline": "R8 replaced ProGuard",
        "highlight": "R8",
        "items": [
          { "text": "ProGuard", "icon": "file", "cue": "pg" },
          { "text": "ProGuard rules", "icon": "code", "cue": "rules" }
        ],
        "result": { "text": "R8", "sub": "DEFAULT IN ANDROID BUILDS", "cue": "r8" }
      },
      "sentences": [
        { "caption": "*ProGuard*#pg was the original tool | that shrinks and protects Java code." },
        { "caption": "*R8*#r8 is Google's replacement, | and it's now the *default* in Android builds." },
        { "caption": "It even reads the same ProGuard *rules*.#rules" }
      ]
    },
    {
      "id": "does",
      "visual": {
        "type": "cards",
        "label": "WHAT R8 DOES",
        "cards": [
          { "title": "Shrinking", "sub": "unused code removed", "icon": "layers", "cue": "c1" },
          { "title": "Optimization", "sub": "smaller, faster code", "icon": "sparkle", "cue": "c2" },
          { "title": "Obfuscation", "sub": "names become a, b", "icon": "eyeOff", "cue": "c3" },
          { "title": "Smaller app", "sub": "harder to reverse", "icon": "download", "cue": "c4" }
        ]
      },
      "sentences": [
        { "caption": "First: *shrinking*.#c1 | It removes unused classes, methods and resources." },
        { "caption": "Second: *optimization*.#c2 | It rewrites your code to be smaller and faster." },
        { "caption": "Third: *obfuscation*.#c3 | It renames classes and methods | to short names like a and b." },
        { "caption": "The result: | a *smaller*#c4 app | that's harder to reverse engineer." }
      ]
    },
    {
      "id": "catch",
      "visual": {
        "type": "terminal",
        "label": "THE CATCH",
        "title": "logcat",
        "command": "adb logcat",
        "cue": "reflection",
        "lines": [
          { "text": "FATAL EXCEPTION: main", "tone": "dim", "flag": "break" },
          { "text": "ClassNotFoundException: a.b", "tone": "dim", "flag": "break" },
          { "text": "  at a.c.d(Unknown Source)", "tone": "dim", "flag": "unreadable" },
          { "text": "  at a.e.f(Unknown Source)", "tone": "dim", "flag": "unreadable" }
        ],
        "badge": { "text": "-keep rules + mapping.txt", "cue": "keep" }
      },
      "sentences": [
        { "caption": "R8 can't see code | you only reach through *reflection*.#reflection" },
        { "caption": "So JSON models and some libraries | *break*#break at runtime." },
        { "caption": "Fix it with *keep*#keep rules, | or the at-*Keep* annotation.", "say": "Fix it with keep rules, or the at Keep annotation." },
        { "caption": "And upload your *mapping* file, | or your crash reports become *unreadable*.#unreadable" }
      ]
    },
    {
      "id": "rule",
      "visual": {
        "type": "editor",
        "label": "THE RULE",
        "file": "build.gradle.kts",
        "lines": [
          { "text": "buildTypes {" },
          { "text": "  release {" },
          { "text": "    isMinifyEnabled = true", "cue": "gradle", "hl": true },
          { "text": "    isShrinkResources = true", "cue": "gradle", "hl": true },
          { "text": "  }" },
          { "text": "}" }
        ],
        "toast": { "text": "Test the release build", "cue": "release" }
      },
      "sentences": [
        { "caption": "Enable it with *isMinifyEnabled*#gradle | set to true.", "say": "Enable it with is minify enabled, set to true." },
        { "caption": "Then test the *release*#release build, | not just debug." }
      ]
    },
    {
      "id": "cta",
      "visual": {
        "type": "follow",
        "label": "FOLLOW",
        "headline": "More Android tips",
        "highlight": "Android",
        "name": "Fahim Khan",
        "tagline": "PRACTICAL ANDROID DEV TIPS",
        "cue": "follow"
      },
      "sentences": [
        { "caption": "*Follow*#follow for more Android tips." }
      ]
    }
  ]
}
