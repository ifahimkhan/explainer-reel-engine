          { "label": "Measure frame time", "sub": "not just FPS", "icon": "check", "cue": "rule" }
        ]
      },
      "sentences": [
        { "caption": "For games, Google's *Frame*#lib *Pacing* library | keeps frames evenly spaced." },
        { "caption": "*Measure*#rule frame time, | not just FPS." }
      ]
    },
