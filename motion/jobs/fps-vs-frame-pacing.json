  "scenes": [
    {
      "id": "hook",
      "visual": {
        "type": "title",
        "label": "FPS VS FRAME PACING",
        "kicker": "FPS VS FRAME TIME",
        "headline": "60 FPS. Still stutters.",
        "highlight": "stutters",
        "icon": "video",
        "sub": { "text": "It's frame pacing", "cue": "pacing" }
      },
      "sentences": [
        { "caption": "Your app runs at 60 *FPS*." },
        { "caption": "But it still feels *choppy*." },
        { "caption": "The problem isn't FPS. | It's frame *pacing*.#pacing" }
      ]
    },
    {
      "id": "fps",
      "visual": {
        "type": "stat",
        "label": "FPS",
        "kicker": "FRAMES PER SECOND",
        "value": 60,
        "from": 0,
        "suffix": " fps",
        "caption": "An average. Averages hide spikes.",
        "icon": "video",
        "cue": "counts"
      },
      "sentences": [
        { "caption": "*FPS* counts#counts how many frames | you draw in one second." },
        { "caption": "It's an *average*, | and averages hide spikes." }
      ]
    },
    {
      "id": "frametime",
      "visual": {
        "type": "compare",
        "label": "FRAME TIME",
        "left": { "kicker": "60 HZ", "title": "16.67 ms", "items": ["Budget per frame"], "cue": "h60" },
        "right": { "kicker": "120 HZ", "title": "8.33 ms", "items": ["Half the time"], "cue": "h120" }
      },
      "sentences": [
        { "caption": "*Frame* *time* is how long each single frame takes, | in milliseconds." },
        { "caption": "At 60#h60 hertz, | every frame gets about *16* milliseconds." },
        { "caption": "At 120#h120 hertz, | only about *8*." }
      ]
    },
    {
      "id": "pacing",
      "visual": {
        "type": "journey",
        "label": "FRAME PACING",
        "headline": "Same 60 FPS. Uneven.",
        "highlight": "Uneven",
        "stops": [
          { "name": "8 ms", "sub": "frame 1", "icon": "check", "cue": "p1" },
          { "name": "25 ms", "sub": "frame 2", "icon": "flame", "cue": "p2", "tone": "bad" },
          { "name": "8 ms", "sub": "frame 3", "icon": "check", "cue": "p3" },
          { "name": "25 ms", "sub": "frame 4", "icon": "flame", "cue": "p4", "tone": "bad" }
        ],
        "note": { "text": "Steady 30 can beat uneven 60", "cue": "steady" }
      },
      "sentences": [
        { "caption": "*Frame* *pacing* is how evenly those frames arrive." },
        { "caption": "Picture this: | one frame takes 8#p1 milliseconds, | the next takes 25.#p2" },
        { "caption": "The average still says 60#p3 FPS, | but your eyes see a *stutter*.#p4" },
        { "caption": "That's why a *steady*#steady 30 FPS | can feel smoother than an uneven 60." }
      ]
    },
    {
      "id": "measure",
      "visual": {
        "type": "terminal",
        "label": "HOW TO MEASURE",
        "title": "adb",
        "command": "adb shell dumpsys gfxinfo app",
        "cue": "gfx",
        "lines": [
          { "text": "50th percentile: 9ms", "tone": "good" },
          { "text": "90th percentile: 24ms", "tone": "dim", "flag": "slow" },
          { "text": "99th percentile: 41ms", "tone": "dim", "flag": "slow" },
          { "text": "Janky frames: 18%", "tone": "dim", "flag": "janky" }
        ],
        "badge": { "text": "Perfetto · Macrobenchmark", "cue": "perf" }
      },
      "sentences": [
        { "caption": "Don't just watch the FPS *counter*." },
        { "caption": "Use dumpsys#gfx gfxinfo for frame-time *percentiles*, | and janky#janky frames." },
        { "caption": "Use *Perfetto*#perf or Macrobenchmark | to find the slow#slow frames." }
      ]
    },
    {
      "id": "rule",
      "visual": {
        "type": "steps",
        "label": "THE RULE",
        "title": "Smooth, not just fast",
        "steps": [
