{
  "id": "upi-layers",
  "engine": "elevenlabs",
  "voice": "ruZOzaKd6ljzH7J9ejYE",
  "model": "eleven_v3",
  "voiceSettings": {
    "stability": 0.5,
    "similarity_boost": 0.8
