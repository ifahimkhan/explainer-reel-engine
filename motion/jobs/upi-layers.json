        "yMax": 100,
        "unit": "%",
        "dropMin": 40,
        "dropLabel": "UPI Lite",
        "start": "tea",
        "end": "nopin",
        "limit": {
          "value": 80,
          "label": "overload"
        },
        "note": {
          "text": "Tiny payments stay on your phone",
          "cue": "nopin"
