      "sentences": [
        {
          "caption": "Then millions#tea pay ₹10 for tea, | and every tiny payment hits the bank's *core system*.",
          "say": "Then millions pay ten rupees for tea, and every tiny payment hits the bank's core system."
        },
        {
          "caption": "So small payments go through *UPI Lite*. | A small balance on your phone. | No PIN for tiny amounts.#nopin"
        }
      ]
    },
    {
      "id": "fraud",
      "visual": {
        "type": "phoneflow",
        "label": "LAYER 7 · FRAUD CHECKS",
        "phones": [
          {
            "owner": "Your phone",
            "screens": [
              {
                "cue": "collect",
                "kind": "pay",
                "to": "Scammer",
                "amount": "₹2,000",
                "button": "Enter PIN to receive",
                "press": false
              },
              {
                "cue": "receive",
                "kind": "pin",
                "title": "Enter PIN to receive",
                "sub": "PIN = MONEY OUT",
                "tone": "bad"
              },
              {
                "cue": "flag",
                "kind": "status",
                "tone": "bad",
                "icon": "bell",
                "title": "Risky request",
                "sub": "You are paying, not receiving"
              }
            ]
          }
        ],
        "note": {
          "text": "Your PIN is only for sending",
          "cue": "send"
        }
      },
      "sentences": [
        {
          "caption": "Then scammers send collect requests:#collect | \"Enter your PIN#receive to receive money.\""
        },
        {
          "caption": "But your PIN is only for *sending*.#send | Never for receiving."
        },
        {
          "caption": "So apps flag#flag risky requests and warn you: | \"You are paying, not *receiving*.\""
        }
      ]
    },
