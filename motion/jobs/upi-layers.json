      "sentences": [
        {
          "caption": "After years of work, | UPI is instant, secure, | and works at every *chai stall*."
        },
        {
          "caption": "Then a caller#call says, | \"Sir, I'm from your bank. | Enter your PIN to get your refund.\""
        },
        {
          "caption": "And you *do*.#you"
        },
        {
          "caption": "\"Money sent.#gone | To *someone else*.\""
        },
        {
          "caption": "No layer can protect a PIN you *share*.#share"
        }
