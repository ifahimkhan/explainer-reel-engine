      "sentences": [
        { "caption": "First: an incoming *call*.#c1 | Your app goes to the background, | and audio or video must pause." },
        { "caption": "Second: *notifications*#c2 and messages. | A banner or an SMS pops up, | and the user may tap it and leave." },
        { "caption": "Third: *battery*#c3 events. | A low-battery warning, battery saver turning on, | or the charger being plugged in." },
        { "caption": "Fourth: *network*#c4 loss. | Wi-Fi drops or airplane mode turns on | in the middle of a request." }
      ]
