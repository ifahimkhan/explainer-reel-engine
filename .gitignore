# Secrets
.env
.env.*
!.env.example
**/.env.local
motion/.env.local

# Rendered videos / user reference material (folders kept via .gitkeep)
output/*
!output/.gitkeep
reference/*
!reference/.gitkeep

# Local tooling / caches
node_modules/
.venv/
__pycache__/
.cache/
.ruff_cache/
out/
.claude/settings.local.json

# Generated narration (rebuild with motion/tts) and third-party ad clips
motion/public/**/voice.wav
motion/public/voice/
motion/public/ad13/

# Local OmniVoice engine: venv and voice reference clips (own voice, not committed)
motion/.venv-omnivoice/
motion/voices/*.wav
# ...except reference clips a job actually uses (refAudio)
!motion/voices/fahim-v3-ref.wav
